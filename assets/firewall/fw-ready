#!/bin/sh
# Healthcheck. The agent's `depends_on: service_healthy` hangs on this, so it
# must be true only once the rules are posed AND the resolver answers.
set -eu

test -f /run/nunki/firewall.ready || exit 1
nft list table inet nunkifw >/dev/null 2>&1 || exit 1
nslookup -type=a -timeout=1 nunki-firewall-self-check.invalid 127.0.0.1 >/dev/null 2>&1 && exit 1
exit 0
